      "keywords": [
        "luminous atmospheric lighting",
        "god rays through clouds",
        "volumetric sunlight",
        "soft bloom",
        "gradient sunset sky",
        "deep atmospheric perspective",
        "detailed painterly clouds"
      ],
      "artist_hint": "Makoto Shinkai inspired",
