{
  "version": "1.0.0",
  "note": "动漫风格转换预设库。keywords 为英文视觉特征词（跨模型通用），artist_hint 为可选艺术家风格引用（需显式 --artist 开启）。",
  "presets": [
    {
      "id": "japanese-tv-cel",
      "name_zh": "日系 TV 赛璐璐",
      "name_en": "Japanese TV Cel Animation",
      "summary": "90-2000 年代日本电视动画质感：平涂色块 + 硬边阴影 + 细线稿，色彩饱和。",
      "keywords": [
        "anime style",
        "cel shading",
        "flat color blocks",
        "hard-edged shadows",
        "thin clean lineart",
        "saturated tv anime palette",
        "official anime key visual"
      ],
      "subject_hint": "人物、校园、日常场景、角色立绘",
      "avoid_for": "写实风景、产品图、需要保留照片质感的场景",
      "fidelity": "medium-high",
      "fidelity_reason": "赛璐璐靠色块重构，需要保留原图的构图与主体轮廓；fidelity 过低会连姿势一起重画。",
      "negative_extra": ["painterly brush strokes", "3d render", "photorealistic skin"]
    },
    {
      "id": "luminous-cinematic",
      "name_zh": "电影级透亮光影",
